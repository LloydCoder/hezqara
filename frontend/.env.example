# HEZQARA frontend environment template
# Copy to frontend/.env.local for local development. Never commit real credentials.
# Safe to expose in the browser: Clerk publishable key only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional browser API origin. Leave empty to use the Next.js /api/v1 rewrite.
NEXT_PUBLIC_API_URL=

# Server-side Next.js rewrite target. In Docker this is http://backend:8004.
HEZQARA_API_INTERNAL_URL=http://localhost:8004
