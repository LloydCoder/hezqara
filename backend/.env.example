# HEZQARA backend environment template
# Copy to backend/.env for local development. Never commit real credentials.
APP_ENV=development
APP_PORT=8004
LOG_LEVEL=info
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hezqara
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Clerk server authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3004
CLERK_WEBHOOK_SECRET=

# Runtime infrastructure
REDIS_URL=redis://localhost:6379/4

# Billing/provider integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3004/dashboard/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3004/dashboard/billing?checkout=cancelled
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-latest
AI_TIMEOUT_SECONDS=30
